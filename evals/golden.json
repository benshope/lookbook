{
  "description": "Golden planner eval set. Cases run sequentially against one notebook unless fresh:true. Add cases liberally — especially real user misses — before tuning any knob in src/tuning.js.",
  "cases": [
    { "q": "What was our total revenue?", "fresh": true,
      "expect": { "kind": "scalar", "fields": ["order_items.total_revenue"] } },

    { "q": "Total sales for blue jeans",
      "expect": { "kind": "scalar", "fields": ["order_items.total_revenue"],
                  "filters": { "products.department": "Jeans" },
                  "answerIncludes": ["blue", "Bluegrain"] } },

    { "q": "Revenue in georgia",
      "expect": { "kind": "clarify", "clarifyTerm": "georgia",
                  "clarifyFields": ["users.state", "products.brand"] } },

    { "q": "Revenue in georgia",
      "choices": { "georgia": { "field": "users.state", "value": "Georgia" } },
      "expect": { "kind": "scalar", "filters": { "users.state": "Georgia" } } },

    { "q": "How is the business doing?", "fresh": true,
      "expect": { "kind": "exec" } },

    { "q": "Top 10 brands by revenue",
      "expect": { "kind": "ranking", "fields": ["products.brand", "order_items.total_revenue"], "limit": 10 } },

    { "q": "gmv by month",
      "expect": { "kind": "trend", "fields": ["order_items.created_month", "order_items.total_revenue"] } },

    { "q": "Only 2025",
      "expect": { "kind": "filter-mutation", "filters": { "order_items.created_year": "2025" } } },

    { "q": "Break that down by department",
      "expect": { "kind": "breakdown-mutation" } },

    { "q": "Show that as a table",
      "expect": { "kind": "table" } },

    { "q": "What are our top sellers?", "fresh": true,
      "expect": { "kind": "ranking", "fields": ["products.brand"], "limit": 10, "answerIncludes": ["verified"] } },

    { "q": "Average order value by state",
      "expect": { "kind": "ranking", "fields": ["users.state", "order_items.average_order_value"], "limit": 10 } },

    { "q": "Sales count by brand",
      "expect": { "kind": "ranking", "answerIncludes": ["Interpreted", "alternates"] } },

    { "q": "Profit for outerwear in california", "fresh": true,
      "expect": { "kind": "scalar", "fields": ["order_items.total_profit"],
                  "filters": { "products.department": "Outerwear", "users.state": "California" } } },

    { "q": "Deep dive on revenue", "mode": "research", "fresh": true,
      "expect": { "kind": "research", "minCells": 10 } },

    { "q": "Revenue from search by month",
      "expect": { "kind": "trend", "filters": { "orders.traffic_source": "Search" } } }
  ]
}
